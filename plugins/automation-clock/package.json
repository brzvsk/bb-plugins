    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "app.tsx",
    "app.css",
    "server.ts",
    "rows.ts",
    "skills/",
    "PLUGIN_OVERVIEW.md",
    "README.md",
    "LICENSE",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "dist/server.js",
    "dist/server.meta.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/node": "^22.0.0",
