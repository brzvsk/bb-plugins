{
  "name": "bb-plugin-automation-clock",
  "version": "0.1.0",
  "description": "Show a clock on sidebar threads that an automation runs in.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
