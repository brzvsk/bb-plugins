{
  "name": "bb-plugin-browser-gestures",
  "version": "0.1.1",
  "description": "Two-finger trackpad swipes go back and forward in the BB desktop browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49 <0.7.0"
  },
