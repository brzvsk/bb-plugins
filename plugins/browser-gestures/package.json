    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "app.tsx",
    "page-script.ts",
    "server.ts",
    "assets/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "dist/server.js",
    "dist/server.meta.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build .",
    "test": "node --test gesture.test.mjs"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "typescript": "5.9.3",
    "@types/react": "19.2.2"
  }
}
