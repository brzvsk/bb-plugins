{
  "name": "bb-plugin-browser-no-drag",
  "version": "0.1.0",
  "description": "Stop web pages from turning BB desktop browser content into a window drag handle.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.46.1",
    "bbPluginSdk": ">=0.6.49 <0.7.0"
  },
  "bb": {
    "name": "Browser No Drag",
    "description": "Makes pages such as Linear clickable again in the BB desktop browser by neutralizing their -webkit-app-region: drag CSS, which otherwise drags the BB window.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "app.tsx",
    "page-script.ts",
    "server.ts",
    "assets/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "dist/app.js",
    "dist/app.css",
    "dist/app.meta.json",
    "dist/server.js",
    "dist/server.meta.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bb plugin build ."
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "typescript": "5.9.3",
    "@types/react": "19.2.2"
  }
}
